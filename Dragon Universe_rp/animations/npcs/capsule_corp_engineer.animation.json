{
    "format_version": "1.8.0",
    "animations": {
        "animation.capsule_corp_engineer.idle": {
            "loop": true,
            "bones": {
                "rightArm": {
                    "rotation": [ "math.cos(q.life_time * 80.0) * 2.0", 0, "-1.0 - math.sin(q.life_time * 100.0) * 1.5" ]
                },
                "leftArm": {
                    "rotation": [ "math.cos(q.life_time * 80.0 + 180.0) * 2.0", 0, "1.0 + math.sin(q.life_time * 100.0) * 1.5" ]
                }
            }
        },
        "animation.capsule_corp_engineer.move": {
            "loop": true,
            "bones": {
                "rightArm": {
                    "rotation": [ "math.cos(q.modified_distance_moved * 38.17) * 45.0 * math.clamp(q.modified_move_speed * 2.0, 0.0, 1.0)", 0, 0 ]
                },
                "leftArm": {
                    "rotation": [ "-math.cos(q.modified_distance_moved * 38.17) * 45.0 * math.clamp(q.modified_move_speed * 2.0, 0.0, 1.0)", 0, 0 ]
                },
                "rightLeg": {
                    "rotation": [ "-math.cos(q.modified_distance_moved * 38.17) * 45.0 * math.clamp(q.modified_move_speed * 2.0, 0.0, 1.0)", 0, 0 ]
                },
                "leftLeg": {
                    "rotation": [ "math.cos(q.modified_distance_moved * 38.17) * 45.0 * math.clamp(q.modified_move_speed * 2.0, 0.0, 1.0)", 0, 0 ]
                }
            }
        },
        "animation.capsule_corp_engineer.look": {
            "loop": true,
            "bones": {
                "head": {
                    "rotation": [ "math.clamp(q.target_x_rotation, -40.0, 40.0)", "math.clamp(q.target_y_rotation, -70.0, 70.0)", 0 ]
                }
            }
        }
    }
}
