{
	"format_version": "1.8.0",
	"animations": {
		"animation.capsule_991.fly": {
			"loop": true,
			"bones": {
				"root": {
					"rotation": ["q.body_x_rotation + q.vertical_speed", "math.clamp(-q.yaw_speed * 0.1, -45, 45)", "math.clamp(q.yaw_speed * 0.1, -45, 45)"],
					"scale": "math.sin(q.anim_time * 3000) * 0.005 + 1"
				},
				"leftEngine": {
					"scale": "math.sin(q.anim_time * 3000) * 0.02 + 1"
				},
				"rightEngine": {
					"scale": "math.sin(q.anim_time * 3000) * 0.02 + 1"
				}
			},
			"particle_effects": {
				"0.0": [
					{
						"effect": "engine",
						"locator": "left_engine"
					},
					{
						"effect": "engine",
						"locator": "right_engine"
					}
				]
			}
		}
	}
}