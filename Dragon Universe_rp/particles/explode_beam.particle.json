{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "dbe:explode_beam",
			"basic_render_parameters": {
				"material": "particles_add",
				"texture": "textures/particle/white"
			}
		},
		"components": {
			"minecraft:emitter_local_space": {
				"position": true,
				"rotation": true,
				"velocity": true
			},
			"minecraft:emitter_rate_instant": {
				"num_particles": 1
			},
			"minecraft:emitter_lifetime_expression": {},
			"minecraft:emitter_shape_point": {
				"offset": [0, 0.01, 0]
			},
			"minecraft:particle_initialization": {
				"per_update_expression": "v.size_y = v.particle_age / v.particle_lifetime * 64;"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "v.explosion_duration"
			},
			"minecraft:particle_motion_parametric": {
				"relative_position": [0, "v.size_y", 0]
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["v.size * v.particle_age / v.particle_lifetime * 0.1", "v.size_y"],
				"facing_camera_mode": "lookat_y"
			},
			"minecraft:particle_appearance_tinting": {
				"color": ["v.color.r", "v.color.g", "v.color.b", "1 - (v.particle_age / v.particle_lifetime)"]
			}
		}
	}
}