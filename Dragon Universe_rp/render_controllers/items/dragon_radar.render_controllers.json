{
    "format_version": "1.8.0",
    "render_controllers": {
        "controller.render.dragon_radar": {
            "arrays": {
                "textures": {
                    "Array.frames": [
                        "Texture.dragon_radar_0",
                        "Texture.dragon_radar_1",
                        "Texture.dragon_radar_2",
                        "Texture.dragon_radar_3"
                    ]
                }
            },
            "geometry": "Geometry.default",
            "part_visibility": [
                { "dragonBall": "q.has_property('dbe:dragon_radar_location') ? q.property('dbe:dragon_radar_location') != 0.0 : 0.0" }
            ],
            "materials": [ { "*": "Material.default" } ],
            "textures": [ "t.life_time = q.life_time * 4; return Array.frames[t.life_time];" ]
        }
    }
}
