{
    "format_version": "1.8.0",
    "render_controllers": {
        "controller.render.saiyan": {
            "geometry": "Geometry.default",
            "materials": [ { "*": "Material.default" } ],
            "textures": [ "Texture.default" ],
            "part_visibility": [
                { "*": true },
                { "breasts": false }
            ]
        },
        "controller.render.saiyan_eyebrows": {
            "geometry": "Geometry.eyes",
            "materials": [ { "*": "Material.alphatest_change_color" } ],
            "textures": [ "v.is_ssj4 ? Texture.eyes_ssj4 : Texture.eyes" ],
            "part_visibility": [
                { "*": false },
                { "eyebrows": "!q.any(v.transformation, 5, 16)" }
            ],
            "overlay_color": {
                "r": "v.color_1_r",
                "g": "v.color_1_g",
                "b": "v.color_1_b",
                "a": 1
            }
        },
        "controller.render.saiyan_eyes_iris": {
            "geometry": "Geometry.eyes",
            "materials": [ { "*": "Material.alphatest_change_color" } ],
            "textures": [ "v.is_ssj4 ? Texture.eyes_ssj4 : Texture.eyes" ],
            "part_visibility": [
                { "*": false },
                { "leftIris": true },
                { "rightIris": true }
            ],
            "overlay_color": {
                "r": "v.color_2_r",
                "g": "v.color_2_g",
                "b": "v.color_2_b",
                "a": 1
            }
        },
        "controller.render.saiyan_eyes_sclera": {
            "geometry": "Geometry.eyes",
            "materials": [ { "*": "Material.default" } ],
            "textures": [ "v.is_ssj4 ? Texture.eyes_ssj4 : Texture.eyes" ],
            "part_visibility": [
                { "*": false },
                { "leftEye": true },
                { "rightEye": true }
            ]
        },
        "controller.render.saiyan_hair": {
            "arrays": {
                "textures": {
                    "Array.hairs": [
                        /*base          */ "Texture.hair",
                        /*oozaru        */ "Texture.hair",
                        /*ssj           */ "Texture.ssj_hair",
                        /*assj          */ "Texture.ssj_hair",
                        /*ssj2          */ "Texture.ssj2_hair",
                        /*ssj3          */ "Texture.ssj3_hair",
                        /*lssj          */ "Texture.lssj_hair",
                        /*ultimate      */ "Texture.ultimate_form_hair",
                        /*golden oozaru */ "Texture.hair",
                        /*ssj4          */ "Texture.ssj4_hair",
                        /*ssjg          */ "Texture.ssjg_hair",
                        /*ssjb          */ "Texture.ssjb_hair",
                        /*ssjr          */ "Texture.ssjr_hair",
                        /*ssjbe         */ "Texture.ssjbe_hair",
                        /*ssjre         */ "Texture.ssjre_hair",
                        /*beast         */ "Texture.beast_hair",
                        /*ultra ego     */ "Texture.ultra_ego_hair"
                    ]
                }
            },
            "geometry": "v.is_beast ? Geometry.beast_hair : Geometry.hair_base",
            "materials": [ { "*": "Material.default" } ],
            "textures": [ "Array.hairs[v.transformation]" ]
        },
        "controller.render.saiyan_oozaru": {
            "geometry": "Geometry.oozaru",
            "materials": [ { "*": "Material.default" } ],
            "textures": [ "v.transformation == 8 ? Texture.golden_oozaru : Texture.oozaru" ]
        },
        "controller.render.saiyan_oozaru_armor": {
            "geometry": "Geometry.oozaru_armor",
            "materials": [ { "*": "Material.default" } ],
            "textures": [ "Texture.oozaru_armor" ]
        },
        "controller.render.saiyan_tail": {
            "geometry": "Geometry.tail",
            "materials": [ { "*": "Material.alphatest_change_color" } ],
            "textures": [ "Texture.tail" ],
            "overlay_color": {
                "r": "v.color_3_r",
                "g": "v.color_3_g",
                "b": "v.color_3_b",
                "a": 1
            }
        }
    }
}