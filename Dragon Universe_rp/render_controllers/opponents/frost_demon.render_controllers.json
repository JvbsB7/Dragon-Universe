{
    "format_version": "1.8.0",
    "render_controllers": {
        "controller.render.frost_demon.horns": {
            "arrays": {
                "textures": {
                    "Array.horns": [
                        "Texture.horns_first_form",
                        "Texture.horns_first_form",
                        "Texture.horns_third_form",
                        "Texture.empty",
                        "Texture.empty",
                        "Texture.horns_fifth_form",
                        "Texture.empty",
                        "Texture.empty",
                        "Texture.empty",
                        "Texture.empty",
                        "Texture.empty"
                    ]  
                }
            },
            "geometry": "Geometry.horns",
            "materials": [ { "*": "Material.default" } ],
            "textures": [ "Array.horns[v.transformation]" ],
            "part_visibility": [
                { "*": true },
                { "*horn*": "v.transformation == 5" },
                { "leftFrontHorn": "v.transformation < 3" },
                { "rightFrontHorn": "v.transformation < 3" },
                { "leftFrontHorn2": "q.any(v.transformation, 1, 2)" },
                { "rightFrontHorn2": "q.any(v.transformation, 1, 2)" },
                { "*leftBackHorn*": "v.transformation == 2" },
                { "*rightBackHorn*": "v.transformation == 2" }
            ]
        }
    }
}