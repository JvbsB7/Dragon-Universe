{
    "format_version": "1.8.0",
    "render_controllers": {
        "controller.render.player.fusion_clothes.first_person": {
            "arrays": {
                "textures": {
                    "Array.metamoran_clothes": [
                        "Texture.metamoran_clothes_1",
                        "Texture.metamoran_clothes_2",
                        "Texture.metamoran_clothes_3"
                    ]
                }
            },
            "geometry": "geometry.clothes",
            "materials": [ { "*": "Material.default" } ],
            "textures": [ "v.fusion_type == 'potara' ? v.is_female ? Texture.kefla_clothes : Texture.vegetto_clothes : Array.metamoran_clothes[v.customization0]" ],
            "part_visibility": [
                { "*": false },
                { "rightArm": "v.rightarm_visible || q.get_equipped_item_name(0, 1) == '' || q.get_equipped_item_name(0, 1) == 'filled_map'" },
                { "leftArm": "v.leftarm_visible || (q.get_equipped_item_name(0, 1) == 'filled_map' && q.get_equipped_item_name('off_hand') != 'shield') || (q.get_equipped_item_name('off_hand') == 'filled_map' && !q.item_is_charged) || (!q.item_is_charged && (v.item_use_normalized > 0 && v.item_use_normalized < 1.0))" }
            ],
            "is_hurt_color": { },
            "on_fire_color": { }
        },

        "controller.render.player.fusion_clothes.third_person": {
            "arrays": {
                "textures": {
                    "Array.metamoran_clothes": [
                        "Texture.metamoran_clothes_1",
                        "Texture.metamoran_clothes_2",
                        "Texture.metamoran_clothes_3"
                    ]
                }
            },
            "geometry": "geometry.clothes",
            "materials": [ { "*": "Material.default" } ],
            "textures": [ "v.fusion_type == 'potara' ? v.is_female ? Texture.kefla_clothes : Texture.vegetto_clothes : Array.metamoran_clothes[v.customization0]" ],
            "part_visibility": [
                { "*": true },
                { "breasts": "v.is_female" }
            ],
            "is_hurt_color": { },
            "on_fire_color": { }
        }
    }
}