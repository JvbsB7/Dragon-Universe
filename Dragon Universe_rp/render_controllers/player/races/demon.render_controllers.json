{
    "format_version": "1.8.0",
    "render_controllers": {
        "controller.render.player.demon.horns": {
            "arrays": {
                "textures": {
                    "Array.std": [
                        "Texture.demon_horns_std_0",
                        "Texture.demon_horns_std_1",
                        "Texture.demon_horns_std_2",
                        "Texture.demon_horns_std_3",
                        "Texture.demon_horns_std_4",
                        "Texture.demon_horns_std_5",
                        "Texture.demon_horns_oni"
                    ],
                    "Array.chilled": [
                        "Texture.demon_horns_chilled_0",
                        "Texture.demon_horns_chilled_1",
                        "Texture.demon_horns_chilled_2",
                        "Texture.demon_horns_chilled_3",
                        "Texture.demon_horns_chilled_4",
                        "Texture.demon_horns_chilled_5",
                        "Texture.demon_horns_oni"
                    ]
                }
            },
            "geometry": "v.customization3 == 1 ? Geometry.frost_demon_chilled_horns : Geometry.frost_demon_horns",
            "materials": [
                {
                    "*": "Material.default"
                }
            ],
            "textures": [
                "v.customization3 == 1 ? Array.chilled[v.transformation] : Array.std[v.transformation]"
            ],
            "part_visibility": [
                {
                    "*": true
                },
                {
                    "*horn*": "v.transformation >= 4"
                },
                {
                    "leftFrontHorn": true
                },
                {
                    "rightFrontHorn": true
                },
                {
                    "leftFrontHorn2": "v.transformation >= 1 || v.customization3 == 1"
                },
                {
                    "rightFrontHorn2": "v.transformation >= 1 || v.customization3 == 1"
                },
                {
                    "*leftBackHorn*": "v.transformation >= 2"
                },
                {
                    "*rightBackHorn*": "v.transformation >= 2"
                }
            ],
            "overlay_color": {
                "r": "v.is_hakai ? 0.65 : v.kaioken_enabled ? 1 : 0",
                "g": 0,
                "b": "v.is_hakai ? 0.8 : 0",
                "a": "(v.is_hakai || v.kaioken_enabled) ? 0.2 : 0"
            }
        },
        "controller.render.player.demon.eyebrows": {
            "arrays": {
                "textures": {
                    "Array.female_eyes": [
                        "Texture.eyes_female_1",
                        "Texture.eyes_female_2"
                    ],
                    "Array.male_eyes": [
                        "Texture.eyes_male_1",
                        "Texture.eyes_male_2"
                    ]
                }
            },
            "geometry": "Geometry.eyes",
            "materials": [
                {
                    "*": "Material.alphatest_change_color"
                }
            ],
            "textures": [
                "v.is_female ? Array.female_eyes[v.customization2] : Array.male_eyes[v.customization2]"
            ],
            "part_visibility": [
                {
                    "*": false
                },
                {
                    "eyebrows": true
                }
            ],
            "color": {
                "r": "v.color_1_r",
                "g": "v.color_1_g",
                "b": "v.color_1_b"
            }
        },
        "controller.render.player.demon.eyes_iris": {
            "arrays": {
                "textures": {
                    "Array.female_eyes": [
                        "Texture.eyes_female_1",
                        "Texture.eyes_female_2"
                    ],
                    "Array.male_eyes": [
                        "Texture.eyes_male_1",
                        "Texture.eyes_male_2"
                    ]
                }
            },
            "geometry": "Geometry.eyes",
            "materials": [
                {
                    "*": "Material.alphatest_change_color"
                }
            ],
            "textures": [
                "v.is_female ? Array.female_eyes[v.customization2] : Array.male_eyes[v.customization2]"
            ],
            "part_visibility": [
                {
                    "*": false
                },
                {
                    "leftIris": true
                },
                {
                    "rightIris": true
                }
            ],
            "color": {
                "r": "v.color_2_r",
                "g": "v.color_2_g",
                "b": "v.color_2_b"
            }
        },
        "controller.render.player.demon.eyes_sclera": {
            "arrays": {
                "textures": {
                    "Array.female_eyes": [
                        "Texture.eyes_female_1",
                        "Texture.eyes_female_2"
                    ],
                    "Array.male_eyes": [
                        "Texture.eyes_male_1",
                        "Texture.eyes_male_2"
                    ],
                    "Array.oni_male_eyes": [
                        "Texture.demon_eyes_oni_male_1",
                        "Texture.demon_eyes_oni_male_2"
                    ],
                    "Array.oni_female_eyes": [
                        "Texture.demon_eyes_oni_female_1",
                        "Texture.demon_eyes_oni_female_2"
                    ]
                }
            },
            "geometry": "Geometry.eyes",
            "materials": [
                {
                    "*": "Material.default"
                }
            ],
            "textures": [
                "v.transformation == 6 ? (v.is_female ? Array.oni_female_eyes[v.customization2] : Array.oni_male_eyes[v.customization2]) : (v.is_female ? Array.female_eyes[v.customization2] : Array.male_eyes[v.customization2])"
            ],
            "part_visibility": [
                {
                    "*": false
                },
                {
                    "leftEye": true
                },
                {
                    "rightEye": true
                }
            ]
        },
        "controller.render.player.demon.first_person": {
            "arrays": {
                "textures": {
                    "Array.female_skins": [
                        "Texture.demon_skin_female_1",
                        "Texture.demon_skin_female_2",
                        "Texture.demon_skin_female_3",
                        "Texture.demon_skin_female_4"
                    ],
                    "Array.male_skins": [
                        "Texture.demon_skin_male_1",
                        "Texture.demon_skin_male_2",
                        "Texture.demon_skin_male_3",
                        "Texture.demon_skin_male_4"
                    ],
                    "Array.oni_male_skins": [
                        "Texture.demon_skin_oni_male_1",
                        "Texture.demon_skin_oni_male_2",
                        "Texture.demon_skin_oni_male_3",
                        "Texture.demon_skin_oni_male_4"
                    ],
                    "Array.oni_female_skins": [
                        "Texture.demon_skin_oni_female_1",
                        "Texture.demon_skin_oni_female_2",
                        "Texture.demon_skin_oni_female_3",
                        "Texture.demon_skin_oni_female_4"
                    ]
                }
            },
            "geometry": "Geometry.glind",
            "materials": [
                {
                    "*": "Material.default"
                }
            ],
            "textures": [
                "v.transformation == 6 ? (v.is_female ? Array.oni_female_skins[v.customization0] : Array.oni_male_skins[v.customization0]) : (v.is_female ? Array.female_skins[v.customization0] : Array.male_skins[v.customization0])"
            ],
            "part_visibility": [
                {
                    "*": false
                },
                {
                    "rightArm": "v.rightarm_visible || q.get_equipped_item_name(0, 1) == '' || q.get_equipped_item_name(0, 1) == 'filled_map'"
                },
                {
                    "leftArm": "v.leftarm_visible || (q.get_equipped_item_name(0, 1) == 'filled_map' && q.get_equipped_item_name('off_hand') != 'shield') || (q.get_equipped_item_name('off_hand') == 'filled_map' && !q.item_is_charged) || (!q.item_is_charged && (v.item_use_normalized > 0 && v.item_use_normalized < 1.0))"
                }
            ],
            "overlay_color": {
                "r": "v.is_hakai ? 0.65 : v.kaioken_enabled ? 1 : 0",
                "g": 0,
                "b": "v.is_hakai ? 0.8 : 0",
                "a": "(v.is_hakai || v.kaioken_enabled) ? 0.2 : 0"
            }
        },
        "controller.render.player.demon.hair": {
            "arrays": {
                "textures": {
                    "Array.hairs": [
                        "Texture.zamasu_hair",
                        "Texture.fused_zamasu_hair"
                    ],
                    "Array.hairs_grayscale": [
                        "Texture.zamasu_hair_grayscale",
                        "Texture.fused_zamasu_hair_grayscale"
                    ]
                }
            },
            "geometry": "Geometry.hair_base",
            "materials": [
                {
                    "*": "v.is_grayscale_hair ? Material.alphatest_change_color : Material.default"
                }
            ],
            "textures": [
                "v.is_grayscale_hair ? Array.hairs_grayscale[v.customization1] : Array.hairs[v.customization1]"
            ],
            "part_visibility": [
                {
                    "*": "!v.hide_hair"
                },
                {
                    "head": true
                }
            ],
            "color": {
                "r": "v.color_1_r",
                "g": "v.color_1_g",
                "b": "v.color_1_b"
            }
        },
        "controller.render.player.demon.third_person": {
            "arrays": {
                "textures": {
                    "Array.female_skins": [
                        "Texture.demon_skin_female_1",
                        "Texture.demon_skin_female_2",
                        "Texture.demon_skin_female_3",
                        "Texture.demon_skin_female_4"
                    ],
                    "Array.male_skins": [
                        "Texture.demon_skin_male_1",
                        "Texture.demon_skin_male_2",
                        "Texture.demon_skin_male_3",
                        "Texture.demon_skin_male_4"
                    ],
                    "Array.oni_male_skins": [
                        "Texture.demon_skin_oni_male_1",
                        "Texture.demon_skin_oni_male_2",
                        "Texture.demon_skin_oni_male_3",
                        "Texture.demon_skin_oni_male_4"
                    ],
                    "Array.oni_female_skins": [
                        "Texture.demon_skin_oni_female_1",
                        "Texture.demon_skin_oni_female_2",
                        "Texture.demon_skin_oni_female_3",
                        "Texture.demon_skin_oni_female_4"
                    ]
                }
            },
            "geometry": "Geometry.glind",
            "materials": [
                {
                    "*": "Material.default"
                }
            ],
            "textures": [
                "v.transformation == 6 ? (v.is_female ? Array.oni_female_skins[v.customization0] : Array.oni_male_skins[v.customization0]) : (v.is_female ? Array.female_skins[v.customization0] : Array.male_skins[v.customization0])"
            ],
            "part_visibility": [
                {
                    "*": true
                },
                {
                    "bra": "!v.hide_bra"
                },
                {
                    "breasts": "v.is_female"
                },
                {
                    "breastsBra": "!v.hide_bra"
                },
                {
                    "leftEar": "!v.hide_left_ear"
                },
                {
                    "rightEar": "!v.hide_right_ear"
                },
                {
                    "leftUnderpants": "!v.hide_underpants"
                },
                {
                    "rightUnderpants": "!v.hide_underpants"
                },
                {
                    "underpants": "!v.hide_underpants"
                }
            ],
            "overlay_color": {
                "r": "v.is_hakai ? 0.65 : v.kaioken_enabled ? 1 : 0",
                "g": 0,
                "b": "v.is_hakai ? 0.8 : 0",
                "a": "(v.is_hakai || v.kaioken_enabled) ? 0.2 : 0"
            }
        },
        "controller.render.player.demon.oni_tail": {
            "arrays": {
                "textures": {
                    "Array.oni_tail": [
                        "Texture.demon_oni_tail"
                    ]
                }
            },
            "geometry": "Geometry.frost_demon",
            "materials": [
                {
                    "*": "Material.default"
                }
            ],
            "textures": [
                "Array.oni_tail[0]"
            ],
            "part_visibility": [
                {
                    "*": false
                },
                {
                    "tail*": true
                }
            ],
            "overlay_color": {
                "r": "v.is_hakai ? 0.65 : v.kaioken_enabled ? 1 : 0",
                "g": 0,
                "b": "v.is_hakai ? 0.8 : 0",
                "a": "(v.is_hakai || v.kaioken_enabled) ? 0.2 : 0"
            }
        }
    }
}
