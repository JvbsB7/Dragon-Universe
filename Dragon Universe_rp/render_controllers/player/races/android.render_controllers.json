{
    "format_version": "1.8.0",
    "render_controllers": {
        "controller.render.player.android.majin_tail": {
            "arrays": {
                "textures": {
                    "Array.majin_tail": [
                        "Texture.android_majin_tail"
                    ]
                }
            },
            "geometry": "Geometry.frost_demon",
            "materials": [ { "*": "Material.default" } ],
            "textures": [ "Array.majin_tail[0]" ],
            "part_visibility": [
                { "*": false },
                { "tail*": true }
            ],
            "overlay_color": {
                "r": "v.is_hakai ? 0.65 : v.kaioken_enabled ? 1 : 0",
                "g": 0,
                "b": "v.is_hakai ? 0.8 : 0",
                "a": "(v.is_hakai || v.kaioken_enabled) ? 0.2 : 0"
            }
        }
    }
}
