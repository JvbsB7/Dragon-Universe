{
    "format_version": "1.8.0",
    "render_controllers": {
        "controller.render.player.glind.eyebrows": {
            "arrays": {
                "textures": {
                    "Array.female_eyes": [
                        "Texture.eyes_female_1",
                        "Texture.eyes_female_2"
                    ],
                    "Array.male_eyes": [
                        "Texture.eyes_male_1",
                        "Texture.eyes_male_2"
                    ]
                }
            },
            "geometry": "Geometry.eyes",
            "materials": [ { "*": "Material.alphatest_change_color" } ],
            "textures": [ "v.is_female ? Array.female_eyes[v.customization2] : Array.male_eyes[v.customization2]" ],
            "part_visibility": [
                { "*": false },
                { "eyebrows": true }
            ],
            "color": {
                "r": "v.color_1_r",
                "g": "v.color_1_g",
                "b": "v.color_1_b"
            }
        },
        "controller.render.player.glind.eyes_iris": {
            "arrays": {
                "textures": {
                    "Array.female_eyes": [
                        "Texture.eyes_female_1",
                        "Texture.eyes_female_2"
                    ],
                    "Array.male_eyes": [
                        "Texture.eyes_male_1",
                        "Texture.eyes_male_2"
                    ]
                }
            },
            "geometry": "Geometry.eyes",
            "materials": [ { "*": "Material.alphatest_change_color" } ],
            "textures": [ "v.is_female ? Array.female_eyes[v.customization2] : Array.male_eyes[v.customization2]" ],
            "part_visibility": [
                { "*": false },
                { "leftIris": true },
                { "rightIris": true }
            ],
            "color": {
                "r": "v.color_2_r",
                "g": "v.color_2_g",
                "b": "v.color_2_b"
            }
        },
        "controller.render.player.glind.eyes_sclera": {
            "arrays": {
                "textures": {
                    "Array.female_eyes": [
                        "Texture.eyes_female_1",
                        "Texture.eyes_female_2"
                    ],
                    "Array.male_eyes": [
                        "Texture.eyes_male_1",
                        "Texture.eyes_male_2"
                    ]
                }
            },
            "geometry": "Geometry.eyes",
            "materials": [ { "*": "Material.default" } ],
            "textures": [ "v.is_female ? Array.female_eyes[v.customization2] : Array.male_eyes[v.customization2]" ],
            "part_visibility": [
                { "*": false },
                { "leftEye": true },
                { "rightEye": true }
            ]
        },
        "controller.render.player.glind.first_person": {
            "arrays": {
                "textures": {
                    "Array.female_skins": [
                        "Texture.glind_skin_female_1",
                        "Texture.glind_skin_female_2",
                        "Texture.glind_skin_female_3",
                        "Texture.glind_skin_female_4"
                    ],
                    "Array.male_skins": [
                        "Texture.glind_skin_male_1",
                        "Texture.glind_skin_male_2",
                        "Texture.glind_skin_male_3",
                        "Texture.glind_skin_male_4"
                    ]
                }
            },
            "geometry": "Geometry.glind",
            "materials": [ { "*": "Material.default" } ],
            "textures": [ "v.is_female ? Array.female_skins[v.customization0] : Array.male_skins[v.customization0]" ],
            "part_visibility": [
                { "*": false },
                { "rightArm": "v.rightarm_visible || q.get_equipped_item_name(0, 1) == '' || q.get_equipped_item_name(0, 1) == 'filled_map'" },
                { "leftArm": "v.leftarm_visible || (q.get_equipped_item_name(0, 1) == 'filled_map' && q.get_equipped_item_name('off_hand') != 'shield') || (q.get_equipped_item_name('off_hand') == 'filled_map' && !q.item_is_charged) || (!q.item_is_charged && (v.item_use_normalized > 0 && v.item_use_normalized < 1.0))" }
            ],
            "overlay_color": {
                "r": "v.is_hakai ? 0.65 : v.kaioken_enabled ? 1 : 0",
                "g": 0,
                "b": "v.is_hakai ? 0.8 : 0",
                "a": "(v.is_hakai || v.kaioken_enabled) ? 0.2 : 0"
            }
        },
        "controller.render.player.glind.hair": {
            "arrays": {
                "textures": {
                    "Array.hairs": [
                        "Texture.zamasu_hair",
                        "Texture.fused_zamasu_hair"
                    ],
                    "Array.hairs_grayscale": [
                        "Texture.zamasu_hair_grayscale",
                        "Texture.fused_zamasu_hair_grayscale"
                    ]
                }
            },
            "geometry": "Geometry.hair_base",
            "materials": [ { "*": "v.is_grayscale_hair ? Material.alphatest_change_color : Material.default" } ],
            "textures": [ "v.is_grayscale_hair ? Array.hairs_grayscale[v.customization1] : Array.hairs[v.customization1]" ],
            "part_visibility": [
                { "*": "!v.hide_hair" },
                { "head": true }
            ],
            "color": {
                "r": "v.color_1_r",
                "g": "v.color_1_g",
                "b": "v.color_1_b"
            }
        },
        "controller.render.player.glind.third_person": {
            "arrays": {
                "textures": {
                    "Array.female_skins": [
                        "Texture.glind_skin_female_1",
                        "Texture.glind_skin_female_2",
                        "Texture.glind_skin_female_3",
                        "Texture.glind_skin_female_4"
                    ],
                    "Array.male_skins": [
                        "Texture.glind_skin_male_1",
                        "Texture.glind_skin_male_2",
                        "Texture.glind_skin_male_3",
                        "Texture.glind_skin_male_4"
                    ]
                }
            },
            "geometry": "Geometry.glind",
            "materials": [ { "*": "Material.default" } ],
            "textures": [ "v.is_female ? Array.female_skins[v.customization0] : Array.male_skins[v.customization0]" ],
            "part_visibility": [
                { "*": true },
                { "bra": "!v.hide_bra" },
                { "breasts": "v.is_female" },
                { "breastsBra": "!v.hide_bra" },
                { "leftEar": "!v.hide_left_ear" },
                { "rightEar": "!v.hide_right_ear" },
                { "leftUnderpants": "!v.hide_underpants" },
                { "rightUnderpants": "!v.hide_underpants" },
                { "underpants": "!v.hide_underpants" }
            ],
            "overlay_color": {
                "r": "v.is_hakai ? 0.65 : v.kaioken_enabled ? 1 : 0",
                "g": 0,
                "b": "v.is_hakai ? 0.8 : 0",
                "a": "(v.is_hakai || v.kaioken_enabled) ? 0.2 : 0"
            }
        }
    }
}