{
    "format_version": "1.26.4",
    "minecraft:entity": {
        "description": {
            "identifier": "dbe:damage_indicator",
            "is_spawnable": false,
            "is_summonable": true
        },

        "component_groups": {
            "dbe:despawn": {
                "minecraft:instant_despawn": { }
            }
        },

        "components": {
            "minecraft:collision_box": {
                "width": 0,
                "height": 0
            },
            "minecraft:damage_sensor": {
                "triggers": {
                    "deals_damage": "no"
                }
            },
            "minecraft:despawn": {
                "filters": {
                    "test": "distance_to_nearest_player",
                    "operator": ">",
                    "value": 32
                }
            },
            "minecraft:health": {
                "value": 1,
                "max": 1,
                "min": 1
            },
            "minecraft:nameable": {
                "always_show": true
            },
            "minecraft:physics": {
                "has_gravity": false,
                "has_collision": false
            },
            "minecraft:scale": {
                "value": 0
            },
            "minecraft:timer": {
                "time": 1,
                "time_down_event": {
                    "event": "dbe:despawn"
                }
            },
            "minecraft:type_family": {
                "family": [
                    "inanimate"
                ]
            },
            "minecraft:conditional_bandwidth_optimization": { },
            "minecraft:fire_immune": { }
        },

        "events": {
            "dbe:despawn": {
                "add": {
                    "component_groups": [ "dbe:despawn" ]
                }
            }
        }
    }
}