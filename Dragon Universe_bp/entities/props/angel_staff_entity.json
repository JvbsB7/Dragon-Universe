{
    "format_version": "1.26.4",
    "minecraft:entity": {
        "description": {
            "identifier": "dbe:angel_staff_entity",
            "is_spawnable": false,
            "is_summonable": true
        },

        "component_groups": {
            "dbe:despawn": {
                "minecraft:instant_despawn": { }
            }
        },

        "components": {
            "minecraft:collision_box": {
                "width": 0.3,
                "height": 3.1
            },
            "minecraft:damage_sensor": {
                "triggers": {
                    "deals_damage": "no"
                }
            },
            "minecraft:health": {
                "value": 1,
                "max": 1,
                "min": 1
            },
            "minecraft:type_family": {
                "family": [
                    "inanimate",
                    "angel_staff"
                ]
            },
            "minecraft:conditional_bandwidth_optimization": { },
            "minecraft:fire_immune": { },
            "minecraft:is_collidable": { },
            "minecraft:physics": { }
        },

        "events": {
            "dbe:despawn": {
                "add": {
                    "component_groups": [ "dbe:despawn" ]
                }
            }
        }
    }
}