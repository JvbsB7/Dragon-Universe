                        "name": "dbe:dirtstone",
                        "states": {
                            "dbe:dirtstone_type": 1
                        }
                    },
                    "has_forest": false,
                    "mid_material": "dbe:dirtstone",
                    "top_material": "dbe:dirtstone_grass",
                    "sea_material": "minecraft:water"
