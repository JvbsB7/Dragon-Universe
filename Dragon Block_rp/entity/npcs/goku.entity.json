{
    "format_version": "1.10.0",
    "minecraft:client_entity": {
        "description": {
            "identifier": "dbe:goku",
            "materials": {
                "default": "entity_alphatest",
                "alphatest_change_color": "entity_alphatest_change_color"
            },
            "textures": {
                "default": "textures/entity/basic_customizations/skins/male_base_2",
                "armor": "textures/models/armors/clothes/goku_clothes",
                "armor2": "textures/models/armors/training_shirt",
                "eyes": "textures/entity/basic_customizations/eyes/male_1_grayscale",
                "eyes_ssj4": "textures/entity/races/saiyan/eyes/male_ssj4_1_grayscale",
                // hairs 
                "hair": "textures/entity/basic_customizations/hairs/goku/goku_base",
                "ssj_hair": "textures/entity/basic_customizations/hairs/goku/goku_ssj",
                "ssj2_hair": "textures/entity/basic_customizations/hairs/goku/goku_ssj2",
                "ssj3_hair": "textures/entity/basic_customizations/hairs/goku/goku_ssj3",
                "lssj_hair": "textures/entity/basic_customizations/hairs/goku/goku_lssj",
                "ultimate_form_hair": "textures/entity/basic_customizations/hairs/goku/goku_ultimate_form",
                "ssj4_hair": "textures/entity/basic_customizations/hairs/goku/goku_ssj4",
                "ssjg_hair": "textures/entity/basic_customizations/hairs/goku/goku_ssjg",
                "ssjb_hair": "textures/entity/basic_customizations/hairs/goku/goku_ssjb",
                "ssjr_hair": "textures/entity/basic_customizations/hairs/goku/goku_ssjr",
                "ssjbe_hair": "textures/entity/basic_customizations/hairs/goku/goku_ssjbe",
                "ssjre_hair": "textures/entity/basic_customizations/hairs/goku/goku_ssjre",
                "beast_hair": "textures/entity/basic_customizations/hairs/goku/goku_beast",
                "ultra_ego_hair": "textures/entity/basic_customizations/hairs/goku/goku_ultra_ego",
                "hair_grayscale": "textures/entity/basic_customizations/hairs/goku/grayscale/goku_base_grayscale",
                "ssj4_hair_grayscale": "textures/entity/basic_customizations/hairs/goku/grayscale/goku_ssj4_grayscale",
                "ultimate_form_hair_grayscale": "textures/entity/basic_customizations/hairs/goku/grayscale/goku_ultimate_form_grayscale"
            },
            "geometry": {
                "default": "geometry.earthling",
                "armor": "geometry.clothes",
                "armor2": "geometry.training_shirt",
                "beast_hair": "geometry.beast_hair",
                "eyes": "geometry.eyes",
                "hair_base": "geometry.hair_base"
            },
            "scripts": {
                "pre_animation": [
                    // colors
                    "v.color_0_value = q.property('dbe:color_0');",
                    "v.color_1_value = q.property('dbe:color_1');",
                    "v.color_2_value = q.property('dbe:color_2');",
                    "v.color_3_value = q.property('dbe:color_3');",
                    "v.color_0_r = (math.floor(v.color_0_value / 1000000) - 100) / 255;",
                    "v.color_0_g = (math.floor(math.mod(v.color_0_value, 1000000) / 1000) - 100) / 255;",
                    "v.color_0_b = (math.mod(v.color_0_value, 1000) - 100) / 255;",
                    "v.color_1_r = (math.floor(v.color_1_value / 1000000) - 100) / 255;",
                    "v.color_1_g = (math.floor(math.mod(v.color_1_value, 1000000) / 1000) - 100) / 255;",
                    "v.color_1_b = (math.mod(v.color_1_value, 1000) - 100) / 255;",
                    "v.color_2_r = (math.floor(v.color_2_value / 1000000) - 100) / 255;",
                    "v.color_2_g = (math.floor(math.mod(v.color_2_value, 1000000) / 1000) - 100) / 255;",
                    "v.color_2_b = (math.mod(v.color_2_value, 1000) - 100) / 255;",
                    "v.color_3_r = (math.floor(v.color_3_value / 1000000) - 100) / 255;",
                    "v.color_3_g = (math.floor(math.mod(v.color_3_value, 1000000) / 1000) - 100) / 255;",
                    "v.color_3_b = (math.mod(v.color_3_value, 1000) - 100) / 255;",
                    "v.aura_color.r = v.color_0_r;",
                    "v.aura_color.g = v.color_0_g;",
                    "v.aura_color.b = v.color_0_b;",
                    "v.ki_attack_color0.value = q.property('dbe:ki_attack_color_0');",
                    "v.ki_attack_color1.value = q.property('dbe:ki_attack_color_1');",
                    "v.ki_attack_color0.r = (math.floor(v.ki_attack_color0.value / 1000000) - 100) / 255;",
                    "v.ki_attack_color0.g = (math.floor(math.mod(v.ki_attack_color0.value, 1000000) / 1000) - 100) / 255;",
                    "v.ki_attack_color0.b = (math.mod(v.ki_attack_color0.value, 1000) - 100) / 255;",
                    "v.ki_attack_color1.r = (math.floor(v.ki_attack_color1.value / 1000000) - 100) / 255;",
                    "v.ki_attack_color1.g = (math.floor(math.mod(v.ki_attack_color1.value, 1000000) / 1000) - 100) / 255;",
                    "v.ki_attack_color1.b = (math.mod(v.ki_attack_color1.value, 1000) - 100) / 255;",
                    // common      
                    "v.aura_enabled = q.property('dbe:aura_boost');",
                    "v.charging_attack = q.property('dbe:charging_attack');",
                    "v.is_falling = q.vertical_speed < -0.2;",
                    "v.is_flying = q.property('dbe:is_flying');",
                    "v.is_idle = !q.ground_speed && !v.charging_attack;",
                    "v.is_knocked_out = q.property('dbe:is_knocked_out');",
                    "v.is_sprinting = q.property('dbe:aura_boost');",
                    "v.is_walking = q.ground_speed;",
                    "v.transformation = q.property('dbe:transformation');",
                    // private
                    "v.is_beast = v.transformation == 15;",
                    "v.is_oozaru = q.any(v.transformation, 1, 8);",
                    "v.is_ssj4 = v.transformation == 9;"
                ],
                "animate": [
                    "root",
                    "hair_move"
                ]
            },
            "animations": {
                "root": "controller.animation.npc.root",
                "blink": "animation.humanoid.blink",
                "bob": "animation.player.bob",
                "look_at_target": "animation.humanoid.look_at_target.default",
                // private
                "hair_move": "animation.player.hair.move"
            },
            "render_controllers": [
                "controller.render.saiyan",
                "controller.render.saiyan_eyebrows",
                "controller.render.saiyan_eyes_iris",
                "controller.render.saiyan_eyes_sclera",
                "controller.render.saiyan_hair",
                "controller.render.entity_armor",
                "controller.render.entity_armor2"
            ]
        }
    }
}