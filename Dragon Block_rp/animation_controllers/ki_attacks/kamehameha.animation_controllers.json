{
	"format_version": "1.10.0",
	"animation_controllers": {
		"controller.animation.player.kamehameha": {
			"states": {
				"default": {
					"transitions": [
						{"first_person_kamehameha": "v.is_first_person && v.charging_attack"},
						{"third_person_kamehameha": "!v.is_first_person && v.charging_attack"}
					],
					"blend_transition": 0.2
				},
				"first_person_kamehameha": {
					"animations": ["ki_attack_setup", "first_person_kamehameha"],
					"particle_effects": [
						{
							"effect": "beam",
							"locator": "rightkiball"
						}
					],
					"transitions": [
						{"default": "!v.charging_attack"},
						{"third_person_kamehameha_in": "!v.is_first_person && v.charging_attack"}
					],
					"blend_transition": 0.2
				},
				"third_person_kamehameha_in": {
					"animations": ["kamehameha_in"],
					"transitions": [
						{"third_person_kamehameha": "q.any_animation_finished"}
					]
				},
				"third_person_kamehameha": {
					"animations": ["ki_attack_setup", "kamehameha"],
					"particle_effects": [
						{
							"effect": "beam",
							"locator": "rightkiball"
						}
					],
					"transitions": [
						{"default": "!v.charging_attack"},
						{"first_person_kamehameha": "v.is_first_person && v.charging_attack"},
						{"third_person_kamehameha_out": "!v.is_first_person && v.charging_attack == -1"}
					],
					"blend_transition": 0.2
				},
				"third_person_kamehameha_out": {
					"animations": ["kamehameha_out"],
					"transitions": [
						{"third_person_kamehameha_launch": "q.any_animation_finished"}
					]
				},
				"third_person_kamehameha_launch": {
					"animations": ["kamehameha_launch"],
					"transitions": [
						{"default": "q.any_animation_finished"}
					],
					"blend_transition": 0.2
				}
			}
		}
	}
}