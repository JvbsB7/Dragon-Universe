{
	"format_version": "1.10.0",
	"animation_controllers": {
		"controller.animation.genki_dama": {
			"states": {
				"default": {
					"transitions": [
						{ "genki_dama_in": "v.charging_attack" },
						{ "genki_dama_out": "v.charging_attack == -1" }
					],
					"blend_transition": 0.2
				},
				"genki_dama_in": {
					"animations": [ "genki_dama_in" ],
					"transitions": [
						{ "genki_dama": "q.any_animation_finished" }
					]
				},
				"genki_dama": {
					"animations": [ "ki_attack_setup", "genki_dama" ],
					"transitions": [
						{ "default": "!v.charging_attack" },
						{ "genki_dama_out": "v.charging_attack == -1" }
					],
					"blend_transition": 0.2
				},
				"genki_dama_out": {
					"animations": [ "genki_dama_out" ],
					"transitions": [
						{ "genki_dama_launch": "q.any_animation_finished" }
					]
				},
				"genki_dama_launch": {
					"animations": [ "genki_dama_launch" ],
					"transitions": [
						{ "default": "q.any_animation_finished || q.is_moving" }
					],
					"blend_transition": 0.2
				}
			}
		},
		"controller.animation.player.first_peron_genki_dama": {
			"states": {
				"default": {
					"transitions": [
						{ "genki_dama": "v.charging_attack" }
					],
					"blend_transition": 0.2
				},
				"genki_dama": {
					"animations": [ "ki_attack_setup", "first_person_genki_dama" ],
					"transitions": [
						{ "default": "!v.charging_attack" }
					],
					"blend_transition": 0.2
				}
			}
		}
	}
}