{
	"format_version": "1.10.0",
	"animation_controllers": {
		"controller.animation.color_sync": {
			"states": {
				"default": {
					"transitions": [
						{ "color1": "v.isLive && v.color_1 != q.property('dbe:color_1')" },
						{ "color2": "v.isLive && v.color_2 != q.property('dbe:color_2')" },
						{ "color3": "v.isLive && v.color_3 != q.property('dbe:color_3')" }
					]
				},
				"color1": {
					"transitions": [
						{ "default": "1.0" }
					],
					"on_entry": [
						"v.color_1 = q.property('dbe:color_1');",
						"v.color_1_r = (math.floor(v.color_1 / 1000000) - 100) / 255;",
						"v.color_1_g = (math.floor(math.mod(v.color_1, 1000000) / 1000) - 100) / 255;",
						"v.color_1_b = (math.mod(v.color_1, 1000) - 100) / 255;"
					]
				},
				"color2": {
					"transitions": [
						{ "default": "1.0" }
					],
					"on_entry": [
						"v.color_2 = q.property('dbe:color_2');",
						"v.color_2_g = (math.floor(math.mod(v.color_2, 1000000) / 1000) - 100) / 255;",
						"v.color_2_b = (math.mod(v.color_2, 1000) - 100) / 255;",
						"v.color_2_r = (math.floor(v.color_2 / 1000000) - 100) / 255;"
					]
				},
				"color3": {
					"transitions": [
						{ "default": "1.0" }
					],
					"on_entry": [
						"v.color_3 = q.property('dbe:color_3');",
						"v.color_3_r = (math.floor(v.color_3 / 1000000) - 100) / 255;",
						"v.color_3_g = (math.floor(math.mod(v.color_3, 1000000) / 1000) - 100) / 255;",
						"v.color_3_b = (math.mod(v.color_3, 1000) - 100) / 255;"
					]
				}
			}
		}
	}
}